# Supabase project (Project Settings -> API). Only the public anon key belongs here.
# NEVER put the service_role key in any VITE_ variable - it would be shipped to browsers.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Public site origin, used for canonical URLs, Open Graph and sitemap.xml
VITE_SITE_URL=https://www.arjunabookofworldrecord.example
